# Copy to .env and `export $(grep -v '^#' .env | xargs)` or use your shell's tooling.

# Where the SQLite file lives (scale_data.py writes it, the API reads it).
DB_PATH=store.db

# Comma-separated API keys accepted in the X-API-Key header.
# Leave unset to run open (dev mode) -- the app will warn.
API_KEYS=dev-key-123,grader-key-456
