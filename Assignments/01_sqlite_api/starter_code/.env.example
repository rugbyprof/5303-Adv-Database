# Copy to .env and `export $(grep -v '^#' .env | xargs)` or use your shell's tooling.

# Folder holding the databases make_dbs.py builds (idx_10k.db, noidx_1m.db, ...).
DATA_DIR=data

# How long (ms) a writer waits for the lock before "database is locked".
# Phase 4 runs once with 0 and once with 5000.
BUSY_TIMEOUT_MS=5000

# Comma-separated API keys accepted in the X-API-Key header.
# Leave unset to run open (dev mode) -- the app will warn.
API_KEYS=dev-key-123,grader-key-456
